# Run npm run setup:env (or node scripts/setup-env.js) to generate .env safely.
NODE_ENV=development
PORT=3000
POSTGRES_USER=shop
POSTGRES_DB=shop
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
DATABASE_URL=postgresql://shop:REPLACE_WITH_RANDOM_HEX@localhost:5433/shop?schema=public
TEST_DATABASE_URL=postgresql://shop:REPLACE_WITH_RANDOM_HEX@localhost:5433/shop_test?schema=public
JWT_SECRET=REPLACE_WITH_AT_LEAST_64_RANDOM_CHARACTERS
JWT_TTL_SECONDS=900
JWT_ISSUER=ecommerce-mvp
JWT_AUDIENCE=ecommerce-clients
AUTH_RATE_LIMIT=20
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD_AT_LEAST_12_CHARACTERS
