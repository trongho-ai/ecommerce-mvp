                  "    pm.expect(body.data.some(function (order) { return order.oid === orderId; })).to.equal(true);",
                  "    body.data.forEach(function (order) { pm.expect(order.uid).to.equal(userId); });",
                  "    pm.expect(body.pagination).to.be.an('object');",
                  "  });",
                  "}"
                ]
              }
            }
