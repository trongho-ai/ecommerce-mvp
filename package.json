{
  "name": "ecommerce-mvp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "setup:env": "node scripts/setup-env.js",
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:generate": "prisma generate --config prisma.config.ts",
    "db:validate": "prisma validate --config prisma.config.ts",
    "db:migrate": "prisma migrate deploy --config prisma.config.ts",
    "db:migrate:test": "node scripts/migrate-test.js",
    "db:seed": "prisma db seed --config prisma.config.ts",
    "smoke": "node scripts/smoke.js",
    "test": "node --test test/unit.test.js test/runtime-health.test.js",
    "test:integration": "node --test test/integration.test.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "prisma": "7.10.1",
    "supertest": "^7.1.4"
  }
}
